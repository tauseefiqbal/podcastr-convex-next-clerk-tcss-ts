# ==============================================
# CONVEX CONFIGURATION
# ==============================================
# Get these from: https://dashboard.convex.dev/
# After creating a new project, find these values in Settings

# Your Convex deployment name
CONVEX_DEPLOYMENT=

# Public Convex URL for your deployment
NEXT_PUBLIC_CONVEX_URL=


# ==============================================
# CLERK AUTHENTICATION
# ==============================================
# Get these from: https://dashboard.clerk.com/
# Create a new application and find these in API Keys

# Public key for Clerk (safe to expose in client-side code)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key for Clerk (keep this private, server-side only)
CLERK_SECRET_KEY=

# Webhook secret for Clerk webhooks (found in Webhooks section)
CLERK_WEBHOOK_SECRET=

# Sign-in and sign-up routes (customize if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL='/sign-in'
NEXT_PUBLIC_CLERK_SIGN_UP_URL='/sign-up'


# ==============================================
# OPENAI CONFIGURATION
# ==============================================
# Get your API key from: https://platform.openai.com/api-keys
# Used for:
# - Text-to-speech generation (TTS-1 model)
# - Thumbnail generation (gpt-image-1-mini model)

OPENAI_API_KEY=
